# Copy to .env (never commit .env). All values below are safe placeholders.
DKA_HOST=127.0.0.1
DKA_PORT=8000
# Long random string; keeps pseudonym tokens stable across restarts. Generate: python -c "import secrets;print(secrets.token_hex(32))"
DKA_SECRET_KEY=replace-me-with-a-long-random-value
DKA_DB_PATH=backend/data/kavach_demo.sqlite3
# Comma-separated origins allowed to call the API from another site (leave empty for same-origin only)
DKA_CORS_ORIGINS=
DKA_RATE_LIMIT_PER_MIN=60
DKA_MAX_IMAGE_MB=5
# Optional model exported from the Colab notebook (see README)
DKA_MODEL_PATH=backend/models/scam_model.joblib
